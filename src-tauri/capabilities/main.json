{
  "identifier": "main-window-default",
  "description": "主窗口默认能力：包含设置文件所需的 Store 插件权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-icon",
    "core:tray:allow-set-icon",
    "autostart:default",
    "dialog:default",
    "notification:default",
    "store:default"
  ]
}
