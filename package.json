{
  "name": "coolapk-desktop",
  "private": true,
  "version": "1.7.0",
  "description": "基于 Tauri 2、Vue 3 和 Rust 的非官方酷安桌面客户端",
  "author": "daimiaopeng",
  "license": "MIT",
  "repository": "https://github.com/daimiaopeng/coolapk-desktop",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/set-version.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cache:cdp": "node scripts/test-resource-cache-cdp.mjs",
    "test:navigation:cdp": "node scripts/test-resource-cache-cdp.mjs",
    "test:feed-navigation:cdp": "node scripts/test-feed-navigation-cdp.mjs",
    "test:home-regressions:cdp": "node scripts/test-home-regressions-cdp.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "@tauri-apps/plugin-stronghold": "^2.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
